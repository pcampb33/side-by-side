# Copy to .env.local. A local run needs only the first two.

# Claude calls. The deployed site uses a key from a dedicated workspace with a spend limit.
ANTHROPIC_API_KEY=
# The SEC requires a name and an email, e.g. "company-compare jane@example.com". Use your own.
SEC_USER_AGENT=

# --- Deployed only ---

# true turns on Google sign-in, per-account limits and spend tracking.
REQUIRE_SIGN_IN=false

# Required when REQUIRE_SIGN_IN=true (Auth.js + Google OAuth client).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required when REQUIRE_SIGN_IN=true: cache, limits, spend and logs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: this account has no limits.
OWNER_EMAIL=
# New generation stops once this month's spend reaches it. Default 5.
MONTHLY_BUDGET_USD=5
