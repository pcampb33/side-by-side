 "filing": {
  "report": {
   "accn": "0000320193-25-000079",
   "filed": "2025-10-31",
   "periodEnd": "2025-09-27",
   "document": "aapl-20250927.htm"
  },
  "overview": "Apple designs, manufactures and markets smartphones, personal computers, tablets, wearables and accessories, and sells a range of related services. It sells through retail and online stores, a direct sales force, and indirect channels such as carriers and resellers.",
  "areas": [
   {
    "id": "a1",
    "name": "iPhone",
    "description": "Smartphones based on iOS, including iPhone 17 Pro, iPhone Air, iPhone 17, iPhone 16 and iPhone 16e. The filing names Android as a competing platform for smartphones.",
    "quotes": [
     {
      "text": "iPhone® is the Company’s line of smartphones based on its iOS operating system.",
      "section": "Item 1"
     },
     {
      "text": "such as Android for smartphones and tablets, Windows for personal computers and tablets, and PlayStation, Nintendo and Xbox for gaming platforms",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "a2",
    "name": "Mac",
    "description": "Personal computers based on macOS, including MacBook Air and MacBook Pro laptops and iMac, Mac mini, Mac Studio and Mac Pro desktops. The filing names Windows as a competing platform for personal computers.",
    "quotes": [
     {
      "text": "Mac® is the Company’s line of personal computers based on its macOS® operating system.",
      "section": "Item 1"
     },
     {
      "text": "Windows for personal computers and tablets",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "a3",
    "name": "iPad",
    "description": "Multipurpose tablets based on iPadOS, including iPad Pro, iPad Air, iPad and iPad mini. The filing names Android and Windows as competing platforms for tablets.",
    "quotes": [
     {
      "text": "iPad® is the Company’s line of multipurpose tablets based on its iPadOS® operating system.",
      "section": "Item 1"
     },
     {
      "text": "such as Android for smartphones and tablets, Windows for personal computers and tablets",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "a4",
    "name": "Wearables, Home and Accessories",
    "description": "Apple Watch, AirPods and Beats headphones, Apple Vision Pro, Apple TV 4K, HomePod speakers and accessories. The filing says it has a minority share of the wearables market.",
    "quotes": [
     {
      "text": "Wearables includes smartwatches, wireless headphones and spatial computers.",
      "section": "Item 1"
     },
     {
      "text": "The Company has a minority market share in the global smartphone, personal computer, tablet and wearables markets",
      "section": "Item 1"
     }
    ]
   },
   {
    "id": "a5",
    "name": "Services",
    "description": "Advertising, AppleCare, cloud services, digital content such as the App Store and Apple Music, and payment services. The filing says it earns licensing revenue from Google for search on its platforms.",
    "quotes": [
     {
      "text": "The Company’s advertising services include third-party licensing arrangements and the Company’s own advertising platforms.",
      "section": "Item 1"
     },
     {
      "text": "the Company earns revenue from licensing arrangements with Google LLC (“Google”) and other companies to offer their search services on the Company’s platforms and applications",
      "section": "Item 1A"
     }
    ]
   }
  ],
  "risks": [
   {
    "id": "r1",
    "theme": "Global competition and pricing",
    "summary": "Markets are highly competitive, with aggressive price competition and pressure on gross margins. Competitors with large installed bases and low-cost structures may copy features or sell at little or no profit.",
    "quotes": [
     {
      "text": "The markets for the Company’s products and services are highly competitive and are characterized by aggressive price competition, downward pressure on gross margins, continual improvement in product performance, and price sensitivity on the part of consumers and businesses.",
      "section": "Item 1"
     },
     {
      "text": "Certain competitors have the resources, experience or cost structures to provide products and services at little or no profit or even at a loss.",
      "section": "Item 1"
     }
    ]
   },
   {
    "id": "r2",
    "theme": "Trade, tariffs and geopolitics",
    "summary": "Tariffs, trade restrictions, geopolitical tension and retaliatory measures could raise costs, limit availability of products and components, and force supply chain changes, particularly given concentrated manufacturing in Asia.",
    "quotes": [
     {
      "text": "Restrictive measures can increase the cost or limit the availability of the Company’s products and the components and rare earths and other raw materials that go into them.",
      "section": "Item 1A"
     },
     {
      "text": "Beginning in the second quarter of 2025, new tariffs were announced on imports to the U.S. (“U.S. Tariffs”), including additional tariffs on imports from China, India, Japan, South Korea, Taiwan, Vietnam and the European Union (“EU”), among others.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r3",
    "theme": "Outsourced manufacturing and supply",
    "summary": "Most hardware is assembled by outsourcing partners primarily in Asia, and many components come from single or limited sources, creating shortage, pricing and capacity risks.",
    "quotes": [
     {
      "text": "The Company relies on single-source partners in the U.S., Asia and Europe to supply and manufacture many components, and on partners primarily located in Asia, for final assembly of substantially all of the Company’s hardware products.",
      "section": "Item 1A"
     },
     {
      "text": "Because the Company currently obtains certain components from single or limited sources, the Company is subject to significant supply and pricing risks.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r4",
    "theme": "Dependence on single product category",
    "summary": "A significant portion of net sales comes from one product category, so a drop in demand for that product could significantly affect net sales and gross margins.",
    "quotes": [
     {
      "text": "Further, the Company generates a significant portion of its net sales from a single product category and a decline in demand for that product could significantly impact net sales and gross margins.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r5",
    "theme": "Antitrust and regulation of app store and search",
    "summary": "Antitrust suits, investigations and the EU Digital Markets Act could force changes to App Store terms and revenue. A Google search-licensing remedy could reduce the company's search-related revenue.",
    "quotes": [
     {
      "text": "If such investigations or litigation are resolved against the Company, the Company can be exposed to significant fines and may be required to make further changes to its business practices, all of which could materially adversely affect the Company’s business, reputation, results of operations, financial condition and stock price.",
      "section": "Item 1A"
     },
     {
      "text": "A reversal of the order on appeal could result in imposition of certain remedies initially proposed by the DOJ, such as those prohibiting Google from offering the Company commercial terms for search distribution.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r6",
    "theme": "Cybersecurity and data privacy",
    "summary": "The company is a frequent target of cyberattacks and must protect large volumes of personal and health data. Breaches or privacy-law noncompliance could bring penalties, litigation and reputational harm.",
    "quotes": [
     {
      "text": "The Company experiences malicious attacks and other attempts to gain unauthorized access to its systems on a regular basis.",
      "section": "Item 1A"
     },
     {
      "text": "the Company is at a relatively greater risk of being targeted because of its high profile and the value of the confidential information it creates, owns, manages, stores and processes.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r7",
    "theme": "Third-party software and content",
    "summary": "Customers' purchase decisions depend partly on third-party apps, and developers may favor competing platforms. Licensed digital content may not be renewed on acceptable terms.",
    "quotes": [
     {
      "text": "The Company believes decisions by customers to purchase its hardware products depend in part on the availability of third-party software applications and services.",
      "section": "Item 1A"
     },
     {
      "text": "The licensing or other distribution arrangements for this content can be for relatively short time periods and do not guarantee the continuation or renewal of these arrangements on commercially reasonable terms, or at all.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r8",
    "theme": "Intellectual property and licensing",
    "summary": "Products may be alleged to infringe third-party patents, and necessary licenses may not be available on reasonable terms. The company faces frequent patent claims, including in AI-related areas.",
    "quotes": [
     {
      "text": "The Company is not always able to obtain all necessary licenses to third-party intellectual property rights on commercially reasonable terms or at all.",
      "section": "Item 1A"
     },
     {
      "text": "The Company has faced and continues to face a significant number of patent claims relating to its standards-enabled products, and new claims may arise in the future",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r9",
    "theme": "Product defects and quality",
    "summary": "Complex hardware and software may contain defects, outages or safety issues. These could lead to recalls, warranty costs, liability claims and harm to reputation.",
    "quotes": [
     {
      "text": "The Company offers complex hardware and software products and services that can be affected by design and manufacturing defects.",
      "section": "Item 1A"
     },
     {
      "text": "In addition, the Company can be exposed to product liability claims, recalls, product replacements or modifications, write-offs of inventory, property, plant and equipment or intangible assets, and significant warranty and other expenses, including litigation costs and regulatory fines.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r10",
    "theme": "Foreign exchange and tax",
    "summary": "Most sales are made outside the U.S., so currency movements affect demand, pricing and margins. Changes in tax law or tax examinations could also increase tax costs.",
    "quotes": [
     {
      "text": "The Company’s primary exposure to movements in foreign exchange rates relates to non–U.S. dollar–denominated sales, cost of sales and operating expenses worldwide.",
      "section": "Item 1A"
     },
     {
      "text": "The Company is subject to changes in tax rates, the adoption of new U.S. or international tax legislation and exposure to additional tax liabilities.",
      "section": "Item 1A"
     }
    ]
   }
  ],
  "droppedQuotes": 0,
  "fiscalYear": 2025
 }
}
