   "document": "goog-20251231.htm"
  },
  "overview": "Alphabet is a collection of businesses, the largest of which is Google. Google reports two segments, Google Services and Google Cloud, and non-Google businesses are grouped as Other Bets.",
  "areas": [
   {
    "id": "a1",
    "name": "Google Services advertising",
    "description": "Performance and brand advertising on Google Search and other properties, YouTube, and Google Network partner sites, sold to advertisers, agencies, and publishers. The text names no specific competitors for this line.",
    "quotes": [
     {
      "text": "Google Services generates revenues primarily by delivering both performance and brand advertising that appears on Google Search & other properties, YouTube, and Google Network partners' properties",
      "section": "Item 1"
     }
    ]
   },
   {
    "id": "a2",
    "name": "Consumer subscriptions",
    "description": "Paid subscriptions, mainly YouTube services such as YouTube TV, YouTube Music and Premium, and NFL Sunday Ticket, plus Google One, which offers access to the most capable Gemini models.",
    "quotes": [
     {
      "text": "consumer subscriptions, which primarily include revenues from YouTube services, such as YouTube TV, YouTube Music and Premium, and NFL Sunday Ticket, as well as Google One, which offers access to our most capable Gemini models;",
      "section": "Item 1"
     }
    ]
   },
   {
    "id": "a3",
    "name": "Google Cloud",
    "description": "Cloud infrastructure, AI development platform, cybersecurity, data analytics, and agent offerings such as Gemini Enterprise, sold through fees and subscriptions. Competitors are named only generally, as enterprise cloud providers.",
    "quotes": [
     {
      "text": "Through our Google Cloud Platform and Google Workspace offerings, Google Cloud generates revenues primarily from consumption-based fees and subscriptions for infrastructure, platform, applications, and other cloud services.",
      "section": "Item 1"
     }
    ]
   },
   {
    "id": "a4",
    "name": "Other Bets",
    "description": "Non-Google businesses at various stages, such as Waymo for autonomous ride-hailing and the X moonshot unit. Revenue comes mainly from autonomous transportation and internet services.",
    "quotes": [
     {
      "text": "Revenues from Other Bets are generated primarily from the sale of autonomous transportation and internet services.",
      "section": "Item 1"
     },
     {
      "text": "our fully autonomous driving technology company, Waymo, is now providing fully autonomous, paid ride-hailing services to customers in multiple cities",
      "section": "Item 1"
     }
    ]
   }
  ],
  "risks": [
   {
    "id": "r1",
    "theme": "Advertising dependence",
    "summary": "Most revenue comes from online advertising, and advertisers and partners can end contracts at any time. Shifts in ad formats, ad blocking, and privacy changes could reduce revenue.",
    "quotes": [
     {
      "text": "We generated more than 70% of total revenues from online advertising in 2025. Many of our advertisers, companies that distribute our products and services, digital publishers, and content providers can terminate their contracts with us at any time.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r2",
    "theme": "Competition",
    "summary": "The company faces many competitors, from large incumbents to start-ups, including AI developers. It must keep innovating or risk losing users, advertisers, and customers.",
    "quotes": [
     {
      "text": "Our business environment is rapidly evolving and intensely competitive. Our businesses face changing technologies, shifting user needs, and frequent introductions of rival products and services.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r3",
    "theme": "Infrastructure costs and AI capacity",
    "summary": "Large spending on AI infrastructure, leases, and long-term commitments raises costs and liabilities. Dependence on third-party equipment and capacity adds further exposure.",
    "quotes": [
     {
      "text": "To meet the compute capacity demands of AI training and inference, as well as traditional cloud computing services, we are entering into significant leasing arrangements with third party operators, which may increase costs and operational complexity.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r4",
    "theme": "Antitrust and regulation",
    "summary": "The company faces multiple US antitrust lawsuits covering advertising technology, Search, and Android and Play Store. Remedies could restrict distribution and business practices, and new laws worldwide add compliance costs.",
    "quotes": [
     {
      "text": "The US Department of Justice (DOJ), various states, and other plaintiffs have filed, and may continue to file in the future, several antitrust lawsuits about aspects of our business, including our advertising technologies and practices, the operation and distribution of Google Search, and the operation and distribution of Android operating system and Play Store.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r5",
    "theme": "Privacy and data protection",
    "summary": "Privacy and data laws are complex and changing, and AI training on user data draws scrutiny. Failure to comply could bring fines, orders to change practices, and reputational harm.",
    "quotes": [
     {
      "text": "Privacy, data protection, data usage, and portability regulations are complex and rapidly evolving areas. Any failure or alleged failure to comply with these laws could harm our business, reputation, financial condition, and operating results.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r6",
    "theme": "Cybersecurity",
    "summary": "The company faces cyber attacks on a regular basis, including nation-state threats, and AI may increase these risks. A breach could cause legal exposure and loss of user trust.",
    "quotes": [
     {
      "text": "We experience cyber attacks and other attempts to gain unauthorized access to our systems on a regular basis. Cyber attacks continue to evolve in sophistication and volume, and inherently may be difficult to detect for long periods of time.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r7",
    "theme": "Power, supply chain, and hardware",
    "summary": "Growth is limited by power, water, and land, and specialized AI chips come from a small number of suppliers. Devices depend on contract manufacturers and some single-source components.",
    "quotes": [
     {
      "text": "Our ability to scale our technical infrastructure is increasingly constrained by the availability of power, water, and land. For example, energy supply is constrained globally due to the significant increase in demand for and limited availability of energy to power AI compute.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r8",
    "theme": "AI product risks",
    "summary": "AI products may produce harmful content, inaccuracies, or infringe rights, and the company may not catch all issues. This could bring regulatory action, liability, and reputational harm.",
    "quotes": [
     {
      "text": "Our evolving AI-enabled products and services may give rise to risks related to harmful content, inaccuracies, discrimination, intellectual property infringement or misappropriation, violation of rights of publicity, defamation, data privacy, cybersecurity, minor protection, and other issues.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r9",
    "theme": "International operations",
    "summary": "A large share of revenue comes from outside the US, exposing the company to sanctions, tariffs, geopolitical conflict, foreign exchange swings, and varied local laws.",
    "quotes": [
     {
      "text": "Our international operations are significant to our revenues and net income, and we plan to continue growing internationally. International revenues accounted for approximately 52% of consolidated revenues in 2025.",
      "section": "Item 1A"
     }
    ]
   },
   {
    "id": "r10",
    "theme": "Founder control",
    "summary": "Larry Page and Sergey Brin hold a majority of the voting power through Class B stock, which limits other stockholders' influence over corporate matters, including a sale of the company.",
    "quotes": [
     {
      "text": "Through their stock ownership, Larry and Sergey have significant influence over all matters requiring stockholder approval, including the election of directors and significant corporate transactions, such as a merger or other sale of our company or our assets, for the foreseeable future.",
      "section": "Item 1A"
     }
    ]
   }
  ],
  "droppedQuotes": 0,
  "fiscalYear": 2025
 }
